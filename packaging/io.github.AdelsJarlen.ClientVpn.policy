<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Client VPN for GNOME (unofficial)</vendor>
  <vendor_url>https://github.com/AdelsJarlen/client-vpn-gnome</vendor_url>
  <icon_name>io.github.AdelsJarlen.ClientVpn</icon_name>

  <action id="io.github.AdelsJarlen.ClientVpn.connect">
    <description>Connect to or disconnect from the Client VPN</description>
    <message>Authentication is required to control the Client VPN</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>

  <action id="io.github.AdelsJarlen.ClientVpn.manage-profile">
    <description>Import an Client VPN profile</description>
    <message>Authentication is required to change the Client VPN profile</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>
</policyconfig>
