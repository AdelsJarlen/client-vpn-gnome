[Desktop Entry]
Name=Client VPN
Comment=Unofficial client for AWS Client VPN with single sign-on
Exec=client-vpn
Icon=io.github.AdelsJarlen.ClientVpn
Terminal=false
Type=Application
Categories=Network;GTK;
Keywords=vpn;aws;openvpn;saml;
StartupNotify=true
DBusActivatable=true
Actions=connect;disconnect;

[Desktop Action connect]
Name=Connect
Exec=client-vpn --connect

[Desktop Action disconnect]
Name=Disconnect
Exec=client-vpn --disconnect
